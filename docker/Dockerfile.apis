FROM golang:1.24-alpine AS builder
WORKDIR /src

COPY packages/database/go.mod packages/database/go.sum* ./packages/database/
WORKDIR /src/packages/database
RUN go mod download

WORKDIR /src/apps/apis
COPY apps/apis/go.mod apps/apis/go.sum ./
RUN go mod download

COPY packages/database/ /src/packages/database/
COPY apps/apis/ /src/apps/apis/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /apis .

FROM alpine:3.22 AS runner
RUN apk add --no-cache ca-certificates \
    && addgroup -S app \
    && adduser -S -G app app
USER app
COPY --from=builder /apis /app/apis

EXPOSE 3001

CMD ["/app/apis"]
